             $ЧЧЋЋЋЋ}Ћ}ЋјЛЛЛЛўў}ЛўђЋљўўЋўўЋўўђЊ<ЛўЁЄўєјT†ўЋЋЋЋўЛЛЛЛ %<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%<hќЁљ}%ЛЛ  $$$$$                          $  j			>      $$$$$$$$                         $ЧЧСЧјЛјИЛЛЛЛЛЛЛГўЋБЅЋhµўўўўўБј}ўўўўўГБўЛЛTЋ№єЋhµГЛЛЛЛ }°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}°ў °}}ЛЛ  $$$$$                          $$j			>!      $$$$$$$$                         $ЧЧЛјЛЧЧЛјЛЛЛЛЛМЦЧЧЧЦПМЦЧЧЧЧЧЧЧЦМЛЛЛМЦЧЧЧСПЛЛЛЛЛЛЛЛЛЛЛ ЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЛЛ  $$$$$                          $  j			>      $$$$$$$$                         $ЧЧ}ЋЋЋЋЋ}ў°ГЛЛНСЦПЧСЛМЦЧЧЧЧЧСПЧЛЛЛЛСПЧСЧЦМЛЛЛЛЛЛЛЛЛЛЛ ЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЋЛЛ  $$$$$                          $$j			>     $$$$$$$$                         $ЧЧСПЛј°АГЛЛЛЛЛМЧЛЛЧЛЛЛЧЧЧЧЧБЧ¶ЛЛЛЛЛЛЧЧјЧЧЛЛЛЛЛЛЛГЛЛЛЛ ЋЋЋЋЋЋЋЋЋЋђђЋЋљЋЋ ЋЋЋЋЋљђЋЋЋЋЋЋЋђђЋЋЋЋЋЋЋЋЋЋЋљђЋљЋЋЋЋЋЋЋЋЋљђЋђ•ђљђЋЋЋЋЋЋЋђ•ђљђљЋљЋЋЋЛЛ  $$$$$                          $  j			>!      $$$$$$$$                         $ЧЧПЧЧЧЧЛЛЛИЛЛЛМЧЄЋЛh°}°°јЈЛЋЁЋјўўЋј°°ЋЛЁ јљ јјўЛЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$j			D!      $$$$$$$$                         $ЧЧЧўhЋ}n °БЛЛЛНЧўTЧўЋ€hЋўh}ў¶јT}Њ<ўhўјЈљЋTЋhўЛЛЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $  j			>      $$$$$$$$                         $ЧЧСј°ў°°ў°ГЛЛЛМЧј°Лј°ЋhЋєЋўўБИ°}h°ўµЋ°Бў}ј}hјЋ¶БЛЛЛЛЛ °Ч№Ћа№}ЧљTјќhЛЁhЛ«}Ч№ЋаµhЛќTјЋTјЋTјќhЧ№Ћа№}Чµ}Ч«hЛќTјЁ}ајЋЧµ}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $$j			>!      $$$$$$$$                         $ЧЧЧЧЧЧЧФНЛЛЛЛЛМЦЧЧЧЦМНЧЧЧЧЧЧЧЧФНЛЛЛМЦЧЧЧЦПЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $  j			>      $$$$$$$$                         $ЧЧЧЧЧЧЧЦМЛЛЛЛЛНФЦЧЦСМЛМЦЦФЦЧЧЧЦЛЛЛЛМЦЧЧЧСЛЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$j	 		>!      $$$$$$$$                         $ЧЧЧЧЧЧЧЦМЛЛЛЛЛЛЧЧЛЧБЛЛЛЛЧЛЛЧЧЧЧЛјЛЛБЧЧЧЧЛЛЛЛЛЛЛЛГЛЛЛЛ °Ч№Ћа№}ЧTјќhЛЄhЛ«}Ч№Ћа¶hЛќTјЋTјЋTјќhЧ№Ћа№}Ч¶}Ч«hЛќTјЄ}ајЋЧ¶}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $  j		>      $$$$$$$$                         $ЧЧЧЧЧЧЧЧБЛЛЛЛЛГµјўЧЋј}hјЁўўјјј°•} ўјЁјјЛќhіўhі°±ИЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$j						>!      $$$$$$$$                         $ЧЧЧЛўd^ЋјЛЛЛЛЛЛў}ўЧTЋ ўўљўЋЁЋhђЄЁЋўЋh}ўў ЋЋЋЋЋTјГЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                           $ j		>      $$$$$$$$                        $$ЧЧЛtT<GIqјЛЛЛЛЛБўјЧ°ўЋјў}јјјјєhЋє°°°јўўјўµЋh®ЋhTўБЛЛЛ °Ч№Ћа№}ЧљTјќhЛЁhЛ«}Ч№ЋаµhЛќTјЋTјЋTјќhЧ№Ћа№}Чµ}Ч«hЛќTјЁ}ајЋЧµ}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $  j		>!      $$$$$$$$                        $$ЧЧђ<<TT<<€ЛЛЛЛНФЧЧЧЦМНФЧЧЧЧЧЧЧПЛЛЛЛМЦЧЧЧЦМЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$ j>	      $$$$$$$$                        $$ЧЧЊ<TўўT<hЛЛЛЛМЦЧЧЧСЛМЦЧЧПСЧЦЧСМЛЛЛЛСПЦЧЦМЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $  		      $$$$$$$$                        $$ЧЧThўTTў\<ЛЛЛЛМЧЧЧЧЧ±ЛЧЧЧјЧЛЧИЧБЛЛЛЛЛЛЛЧЧЛЛЛЛЛјЛИЛЛЛЛ °Ч№Ћа№}ЧTјќhЛЄhЛ«}Ч№Ћа¶hЛќTјЋTјЋTјќhЧ№Ћа№}Ч¶}Ч«hЛќTјЄ}ајЋЧ¶}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $$ 		      $$$$$$$$                         $ЧЧ}<TihT<hЛЛЛЛМЧўјјў}ўј±°Ћ°љ°ўЧўўЛўјЋhљј°јЄЛўhЈБЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$$       $$$$$$$$                        $$ЧЧЁ<<}}<<ЋЛЛЛЛНЧXўhЁ°ў°ўјµЋhЋўЛЄhјThўЋh€ўhјh<јЛЛЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$$$$ $  $             $$$$$$$$                       $$$ЧЧГ}<<<<}єЛЛЛЛМЧўЅ°ГБГБ°ЛЛў}}ГЧ°ЋЛЋўўБјјhЋ°ЋЛЋ°ГЛЛЛЛЛ °Ч№Ћа№}ЧљTјќhЛЁhЛ«}Ч№ЋаµhЛќTјЋTјЋTјќhЧ№Ћа№}Чµ}Ч«hЛќTјЁ}ајЋЧµ}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $$$$$$$$$$$$$                       $$$$$$$$                       $$$ЧЧЧЛўhhЋјЛЛЛЛЛМЦЧЧЧЦМНФЧЧЧЧЧЧЧПЛЛЛЛМЦЧЧЧЦМЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧTј hЛЄhЛ®}ЧєЋа¶hЛ TјЋTјЋTј hЧєЋає}Ч¶}Ч®hЛ TјЄ}ајЋЧ¶}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$$$$$$$$$$$$                     $$$$$$$$                        $$ЧЧЧЧЧЧЧЦМЛЛЛЛЛЛЧЧЧЧЧЛЛЧЧЧЧЧЧЧЧЛЛЛЛЛЛЧЧЧЧЧЛЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋає}Чµ}Ч®hЛ TјЁ}ајЋЧµ}Ч®hЛ Tј hЛ TјЋTјЋTј hЛўhЛўhј®ЋЛЛЛ  $$$$$                          $$$$$$$$$$$$$                     $$$$$$$$                       $$$ЧЧЧЧЧЧЧЦМЛЛЛЛЛЛ °Ч№Ћа№}ЧTјќhЛЄhЛ«}Ч№Ћа¶hЛќTјЋTјЋTјќhЧ№Ћа№}Ч¶}Ч«hЛќTјЄ}ајЋЧ¶}Ч«hЛќTјќhЛќTјЋTјЋTјќhЛўhЛўhј«ЋЛЛЛ  $$$$$                          $$$$$$$$$$$$$                     $$$$$$$$                       $$$ЧЧЧЧЧЧЧЧЛЛЛЛЛЛЛЛЧЧЧЧЧЛЛЧЧЧЧЧЧЧЧЧЛЛЛЛЛЧЧЧЧЧЛЛЛЛЛЛЛЛЛЛЛЛЛ °ЧєЋає}ЧљTј hЛЁhЛ®}ЧєЋаµhЛ TјЋTјЋTј hЧєЋ